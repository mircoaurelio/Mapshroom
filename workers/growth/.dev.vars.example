# Local secrets for the growth Worker (`wrangler dev` in workers/growth).
# Copy to workers/growth/.dev.vars — do not commit real values.

SESSION_SECRET=dev-session-secret-change-me
BREVO_API_KEY=
TURNSTILE_SECRET_KEY=
ADMIN_TOKEN=dev-admin-token
TURNSTILE_ENABLED=0
PUBLIC_BASE_URL=http://localhost:5173
DAILY_EMAIL_BUDGET=300
BREVO_SENDER_EMAIL=download@mapshroom.dev
BREVO_SENDER_NAME=Mapshroom
BREVO_REPLY_TO=download@mapshroom.dev
DESKTOP_OBJECT_KEY=Mapshroom_3.0.0_x64-setup.exe
