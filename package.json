{
  "name": "mapshroom-v3",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "check:secrets": "node ./scripts/check-no-secrets.mjs",
    "check:shaders": "node ./scripts/check-shader-presets.mjs",
    "dev": "vite",
    "dev:desktop": "node ./scripts/run-with-env.mjs MAPSHROOM_DESKTOP=1 vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && node ./scripts/run-with-env.mjs MAPSHROOM_DESKTOP=1 vite build",
    "build:sites": "npm run build && node ./scripts/prepare-sites-build.mjs",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "test:audio": "node --experimental-strip-types --test tests/audioReactivity.test.ts tests/audioTimeline.test.ts",
    "test:desktop": "node --experimental-strip-types --test tests/desktopBridge.test.ts",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "growth:dev": "wrangler dev --config workers/growth/wrangler.toml --port 8788",
    "growth:deploy": "wrangler deploy --config workers/growth/wrangler.toml",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icons:tauri": "node ./scripts/generate-tauri-icons.mjs",
    "pack:msix": "powershell -ExecutionPolicy Bypass -File ./scripts/pack-msix.ps1",
    "release:checksums": "powershell -ExecutionPolicy Bypass -File ./scripts/write-release-checksums.ps1"
  },
  "dependencies": {
    "@google/genai": "^1.48.0",
    "@huggingface/transformers": "^3.7.6",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "jspdf": "^4.2.1",
    "mp4-muxer": "^5.2.2",
    "posthog-js": "^1.405.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.9.6",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/workers-types": "^5.20260821.1",
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "wrangler": "^4.114.0"
  }
}
